version: '3.8'

services:
  # Base de données MySQL
  db:
    build: ./database
    container_name: smarttask_db
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: rootpass
      MYSQL_DATABASE: smarttask_db
    ports:
      - "3306:3306"
    volumes:
      - db_data:/var/lib/mysql
    networks:
      - smarttask_network
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-u", "root", "-prootpass"]
      timeout: 20s
      retries: 10
      interval: 10s
      start_period: 30s

  # Backend Node.js
  backend:
    build: ./backend
    container_name: smarttask_backend
    restart: unless-stopped
    environment:
      DB_HOST: db
      DB_USER: root
      DB_PASSWORD: rootpass
      DB_NAME: smarttask_db
      PORT: 5000
    ports:
      - "5000:5000"
    depends_on:
      db:
        condition: service_healthy
    networks:
      - smarttask_network

  # Frontend React
  frontend:
    build: ./frontend
    container_name: smarttask_frontend
    restart: unless-stopped
    ports:
      - "8081:80"
    depends_on:
      - backend
    networks:
      - smarttask_network

networks:
  smarttask_network:
    driver: bridge
    name: smarttask_network

volumes:
  db_data:
    name: smarttask_db_data
